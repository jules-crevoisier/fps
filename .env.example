# .env.example — copier en `.env` (jamais commité, voir .gitignore) pour
# `docker compose up`. Sur Dokploy, ces mêmes clés vont dans l'onglet
# "Environment" du service (docs/SERVER.md).
#
# PORT/HEALTH_PORT ici contrôlent le port CÔTÉ HÔTE (mapping Docker) — pour
# plusieurs matchs sur la même machine, donner un PORT différent à chaque
# copie du service (voir docker-compose.yml et docs/SERVER.md, "Plusieurs
# matchs"). À l'intérieur du conteneur, le serveur écoute toujours sur les
# ports fixes 7777/8080 (EXPOSE dans le Dockerfile).

# Port UDP du jeu (ENet), côté hôte.
PORT=7777

# Port TCP de la sonde de santé (GET /health), côté hôte.
HEALTH_PORT=8080

# Mode de partie : tdm | hardpoint | snd | duel | duo (MatchConfig.MODES).
MODE=tdm

# Identifiant de carte (MapCatalog) — vide = carte par défaut du mode.
MAP=

# Plafond de joueurs humains simultanés (capacité ENet).
MAX_PLAYERS=16

# Compléter les équipes avec des bots : true|false.
BOTS=true

# Difficulté des bots : recrue | veteran | elite.
BOT_DIFFICULTY=veteran

# Secret HMAC-SHA256 des jetons de connexion (JoinToken.gd) — VIDE = aucun
# jeton exigé (parties LAN/privées). À définir uniquement si un service de
# matchmaking externe délivre des jetons de connexion aux joueurs. Ne JAMAIS
# committer une vraie valeur ici ; ne JAMAIS la journaliser (voir
# ServerBoot._log_event, qui l'omet volontairement).
MATCH_TOKEN_SECRET=

# Identifiant de la partie, utilisé pour lier les jetons de connexion
# (JoinToken) — vide = un identifiant aléatoire est généré au démarrage
# (suffisant sans matchmaking externe, qui a besoin de le connaître à
# l'avance pour délivrer des jetons valides).
MATCH_ID=

# Fin de partie : true = relance un match sur la même carte/mode (défaut,
# conteneur longue durée) ; false = quitte avec le code 0 pour laisser
# l'orchestrateur (Dokploy) recycler le conteneur.
RESTART_ON_END=true
