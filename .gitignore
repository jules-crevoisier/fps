# Godot 4+ specific ignores
.godot/
/android/

# Imported assets cache
.import/

# Exports (export_presets.cfg est versionné pour la CI ; Godot garde les
# identifiants d'export dans .godot/export_credentials.cfg, jamais ici)
/build/
/exports/
*.translation

# Mono / .NET (si jamais on passe sur le build C#)
.mono/
data_*/
*.csproj
*.sln

# OS / éditeurs
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/
reports/

# Secrets locaux (voir .env.example)
.env
.env.*
!.env.example

# Caches Python (scripts Blender/outils)
__pycache__/

# Fichiers de travail des agents et aperçus de rendu (régénérables, lourds)
/scratchpad/
_captures/
*_preview/
*_turntable/

# Références tierces (Pinterest) : jamais publiées — le dépôt est public
/.orchestrator/refs/pinterest/

# Sorties d'outils et scripts jetables des agents à la racine
/.ui_shots_out/
/.probe_debug_out/
/_verify_*
/scratchpad_*
/tools/**/_tmp_*
/tests/**/_diag_*
